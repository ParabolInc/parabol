  "engines": {
    "node": "^24.19.0"
  },
  "private": true,
  "scripts": {
    "start": "pm2-runtime start pm2.config.js",
    "build": "node --max-old-space-size=8192 scripts/prod.js",
    "clean": "git clean -fdx -e .env",
    "codegen": "node scripts/codegenGraphQL.js",
    "pg:generate": "bash -c 'set -a; source .env; set +a; ./node_modules/.bin/kysely-codegen --out-file ./packages/server/postgres/types/pg.d.ts --dialect postgres --url \"postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB\" && biome check --write ./packages/server/postgres/types/pg.d.ts'",
    "pg:restore": "node ./scripts/toolbox/pgRestore.js",
    "db:start": "mkdir -p dev && docker compose -f docker/stacks/development/docker-compose.yml up -d",
    "db:stop": "docker compose -f docker/stacks/development/docker-compose.yml down",
    "predeploy": "node dist/preDeploy.js",
    "predev": "pkill -P 1 -f '(parabol/scripts/|/node scripts/|parabol/node_modules/.*relay)' || true",
    "dev": "bash -c 'set -a; source .env; set +a; PM2_SILENT=true pm2 start pm2.dev.config.js --no-daemon'",
    "biome": "pnpm exec biome check",
    "newMutation": "pnpm sucrase-node scripts/codeshift/newMutation.ts",
    "typecheck": "pnpm -r typecheck",
    "ultrahook": "export $(grep ^ULTRAHOOK_API_KEY .env | tr -d \"'\") && ultrahook -k $ULTRAHOOK_API_KEY dev 3000",
    "precommit": "pnpm -r --workspace-concurrency=1 precommit",
    "postcheckout": "node scripts/generateGraphQLArtifacts.js &>/dev/null &",
    "prepare": "husky install",
    "relay:build": "node scripts/generateGraphQLArtifacts.js",
    "relay:watch": "node scripts/relayWatch.js",
    "test:client": "NODE_TLS_REJECT_UNAUTHORIZED='0' pnpm --filter parabol-client test",
    "test:server": "NODE_TLS_REJECT_UNAUTHORIZED='0' pnpm --filter parabol-server test"
  },
