{
  "name": "parabol-action",
  "description": "An open-source app for building smarter, more agile teams.",
  "author": "Parabol Inc. <love@parabol.co> (http://github.com/ParabolInc)",
  "license": "AGPL-3.0",
  "version": "14.0.0",
  "repository": {
    "type": "git",
