{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // sw.ts ships swc's es2022 target with no polyfills, like the client
    "lib": ["es2022", "webworker"],
    "types": [],
    // sw.ts has no imports or exports, but it must not share a scope with the worker globals it redeclares
    "moduleDetection": "force"
  }
}
